##Common Options Section

set_option projectwdir .
set_option language_mode mixed
set_option designread_enable_synthesis yes
set_option designread_disable_flatten no
set_option enableSV yes
set_option active_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff
set_option top sys_top


##Goal Setup Section

current_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff


current_goal lint/lint_rtl -alltop
read_file -type awl ./sys_lint/lint/lint_rtl/sys_lint_waiver_file.awl
set_goal_option default_waiver_file ./sys_lint/lint/lint_rtl/sys_lint_waiver_file.awl


current_goal lint/lint_rtl -top sys_top
read_file -type awl ./sys_lint/sys_top/lint/lint_rtl/sys_lint_waiver_file.awl


current_goal lint/lint_turbo_rtl -top sys_top
read_file -type awl ./sys_lint/sys_top/lint/lint_turbo_rtl/sys_lint_waiver_file.awl
set_goal_option default_waiver_file ./sys_lint/sys_top/lint/lint_turbo_rtl/sys_lint_waiver_file.awl


current_goal cdc/cdc_setup_check -top sys_top
read_file -type awl ./sys_lint/sys_top/cdc/cdc_setup_check/sys_lint_waiver_file.awl
set_goal_option default_waiver_file ./sys_lint/sys_top/cdc/cdc_setup_check/sys_lint_waiver_file.awl


current_goal cdc/cdc_verify_struct -top sys_top
read_file -type awl ./sys_lint/sys_top/cdc/cdc_verify_struct/sys_lint_waiver_file.awl
set_goal_option default_waiver_file ./sys_lint/sys_top/cdc/cdc_verify_struct/sys_lint_waiver_file.awl


current_goal cdc/cdc_verify -top sys_top
read_file -type awl ./sys_lint/sys_top/cdc/cdc_verify/sys_lint_waiver_file.awl
set_goal_option default_waiver_file ./sys_lint/sys_top/cdc/cdc_verify/sys_lint_waiver_file.awl


current_goal cdc/cdc_abstract -top sys_top
read_file -type awl ./sys_lint/sys_top/cdc/cdc_abstract/sys_lint_waiver_file.awl
set_goal_option default_waiver_file ./sys_lint/sys_top/cdc/cdc_abstract/sys_lint_waiver_file.awl

